{
  "name": "eniem",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:boilerplate": "turbo dev --filter=@eniem/boilerplate",
    "dev:docs": "turbo dev --filter=@eniem/docs",
    "dev:cli": "turbo dev --filter=eniem-cli",
    "eni:plan": "./.eni/loop.sh plan",
    "eni:plan-work": "./.eni/loop.sh plan-work",
    "eni:build": "./.eni/loop.sh build"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "packageExtensions": {
      "@hookform/resolvers@*": {
        "peerDependencies": {
          "zod": "^3.25.0 || ^4.0.0"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      }
    }
  },
  "packageManager": "pnpm@9.15.4"
}
